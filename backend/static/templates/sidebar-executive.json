{
  "id": "sidebar-executive",
  "name": "Sidebar Executive",
  "description": "2-column ATS-friendly resume template with a navy header band, a light sidebar for skills/strengths/education, and gold accent dividers",
  "source": "uploaded",
  "htmlContent": "<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"UTF-8\">\n  <style>\n    @page {\n      margin: 0.3in;\n    }\n    * {\n      margin: 0;\n      padding: 0;\n      box-sizing: border-box;\n    }\n    body {\n      font-family: Calibri, 'Segoe UI', Arial, sans-serif;\n      font-size: 9pt;\n      line-height: 1.25;\n      color: #22262B;\n      margin: 0;\n      padding: 0;\n    }\n    .section:last-child {\n      margin-bottom: 0;\n    }\n    .header-band {\n      background: #1B2A4A;\n      color: #FFFFFF;\n      text-align: center;\n      padding: 14px 10px 12px;\n      margin-bottom: 10px;\n    }\n    .name {\n      font-family: Georgia, 'Times New Roman', serif;\n      font-size: 23pt;\n      font-weight: bold;\n      letter-spacing: 0.5px;\n      color: #FFFFFF;\n      margin-bottom: 3px;\n    }\n    .name-rule {\n      width: 60px;\n      height: 2px;\n      background: #B8862C;\n      margin: 4px auto 6px;\n    }\n    .title {\n      font-size: 10pt;\n      color: #E7DFC9;\n      margin-bottom: 6px;\n      letter-spacing: 0.5px;\n    }\n    .contact {\n      font-size: 8pt;\n      color: #FFFFFF;\n      display: flex;\n      justify-content: center;\n      align-items: center;\n      flex-wrap: wrap;\n      gap: 10px;\n    }\n    .contact-item {\n      display: flex;\n      align-items: center;\n      gap: 3px;\n    }\n    .contact-icon {\n      color: #B8862C;\n    }\n    .contact a {\n      color: #FFFFFF;\n      text-decoration: none;\n    }\n    .main-container {\n      display: flex;\n      gap: 16px;\n    }\n    .sidebar {\n      flex: 0 0 32%;\n      background: #F6F5F2;\n      padding: 10px;\n      border-radius: 2px;\n    }\n    .main-column {\n      flex: 0 0 64%;\n    }\n    .section {\n      margin-bottom: 10px;\n    }\n    .section-title {\n      font-family: Georgia, 'Times New Roman', serif;\n      font-size: 9.5pt;\n      font-weight: bold;\n      color: #1B2A4A;\n      text-transform: uppercase;\n      letter-spacing: 1px;\n      border-bottom: 2px solid #B8862C;\n      padding-bottom: 3px;\n      margin-bottom: 6px;\n    }\n    .summary {\n      font-size: 9pt;\n      line-height: 1.35;\n      text-align: justify;\n      color: #22262B;\n    }\n    .experience-item {\n      margin-bottom: 9px;\n    }\n    .job-title {\n      font-weight: bold;\n      font-size: 10pt;\n      color: #1B2A4A;\n    }\n    .company-line {\n      display: flex;\n      justify-content: space-between;\n      font-size: 8.5pt;\n      color: #5B5F66;\n      text-transform: uppercase;\n      letter-spacing: 0.3px;\n      margin-bottom: 3px;\n    }\n    .company-line span:first-child {\n      color: #22262B;\n      font-weight: bold;\n      text-transform: none;\n      letter-spacing: 0;\n    }\n    .description {\n      font-size: 9pt;\n      margin-bottom: 3px;\n      line-height: 1.3;\n    }\n    .achievements {\n      margin: 0;\n      padding-left: 4px;\n      font-size: 8.5pt;\n      list-style: none;\n    }\n    .achievements li {\n      margin-bottom: 2px;\n      line-height: 1.3;\n      padding-left: 12px;\n      position: relative;\n    }\n    .achievements li::before {\n      content: \"\";\n      position: absolute;\n      left: 0;\n      top: 5px;\n      width: 5px;\n      height: 5px;\n      background: #B8862C;\n    }\n    .strength-item {\n      margin-bottom: 8px;\n    }\n    .strength-header {\n      display: flex;\n      align-items: center;\n      gap: 5px;\n      margin-bottom: 2px;\n    }\n    .strength-icon {\n      color: #B8862C;\n      font-size: 9pt;\n    }\n    .strength-title {\n      font-weight: bold;\n      font-size: 9pt;\n      color: #1B2A4A;\n    }\n    .strength-description {\n      font-size: 8pt;\n      color: #4A4E54;\n      line-height: 1.3;\n    }\n    .skills-list {\n      display: flex;\n      flex-direction: column;\n      gap: 4px;\n    }\n    .skill-box {\n      font-size: 8pt;\n      color: #22262B;\n      padding: 3px 0;\n      border-bottom: 1px solid #DAD6CC;\n    }\n    .skill-box::before {\n      content: \"— \";\n      color: #B8862C;\n      font-weight: bold;\n    }\n    .education-item {\n      margin-bottom: 7px;\n    }\n    .degree {\n      font-weight: bold;\n      font-size: 9pt;\n      color: #1B2A4A;\n    }\n    .institution {\n      font-size: 8pt;\n      color: #22262B;\n    }\n    .edu-date {\n      font-size: 7.5pt;\n      color: #5B5F66;\n      text-transform: uppercase;\n      letter-spacing: 0.3px;\n    }\n  </style>\n</head>\n<body>\n  <div class=\"header-band\">\n    <div class=\"name\">{{name}}</div>\n    <div class=\"name-rule\"></div>\n    <div class=\"title\">{{title}}</div>\n    <div class=\"contact\">\n      <span class=\"contact-item\"><span class=\"contact-icon\">📞</span> {{contact.phone}}</span>\n      <span class=\"contact-item\"><span class=\"contact-icon\">✉</span> {{contact.email}}</span>\n      {{#if contact.linkedin}}<span class=\"contact-item\"><span class=\"contact-icon\">🔗</span> <a href=\"{{contact.linkedin}}\">{{contact.linkedin}}</a></span>{{/if}}\n      <span class=\"contact-item\"><span class=\"contact-icon\">📍</span> {{contact.location}}</span>\n    </div>\n  </div>\n\n  <div class=\"main-container\">\n    <div class=\"sidebar\">\n      {{#if strengths.length}}\n      <div class=\"section\">\n        <div class=\"section-title\">Strengths</div>\n        {{#each strengths}}\n        <div class=\"strength-item\">\n          <div class=\"strength-header\">\n            <span class=\"strength-icon\">★</span>\n            <span class=\"strength-title\">{{title}}</span>\n          </div>\n          <div class=\"strength-description\">{{description}}</div>\n        </div>\n        {{/each}}\n      </div>\n      {{/if}}\n\n      <div class=\"section\">\n        <div class=\"section-title\">Hard Skills</div>\n        <div class=\"skills-list\">\n          {{#if hardSkills.length}}\n          {{#each hardSkills}}\n          <div class=\"skill-box\">{{this}}</div>\n          {{/each}}\n          {{else}}\n          {{#each skills}}\n          <div class=\"skill-box\">{{this}}</div>\n          {{/each}}\n          {{/if}}\n        </div>\n      </div>\n\n      {{#if softSkills.length}}\n      <div class=\"section\">\n        <div class=\"section-title\">Soft Skills</div>\n        <div class=\"skills-list\">\n          {{#each softSkills}}\n          <div class=\"skill-box\">{{this}}</div>\n          {{/each}}\n        </div>\n      </div>\n      {{/if}}\n\n      <div class=\"section\">\n        <div class=\"section-title\">Education</div>\n        {{#each education}}\n        <div class=\"education-item\">\n          <div class=\"degree\">{{degree}}</div>\n          <div class=\"institution\">{{institution}}</div>\n          <div class=\"edu-date\">{{startDate}} - {{endDate}}{{#if location}} | {{location}}{{/if}}</div>\n        </div>\n        {{/each}}\n      </div>\n    </div>\n\n    <div class=\"main-column\">\n      <div class=\"section\">\n        <div class=\"section-title\">Summary</div>\n        <div class=\"summary\">{{summary}}</div>\n      </div>\n\n      <div class=\"section\">\n        <div class=\"section-title\">Experience</div>\n        {{#each experience}}\n        <div class=\"experience-item\">\n          <div class=\"job-title\">{{title}}</div>\n          <div class=\"company-line\">\n            <span>{{company}}</span>\n            <span>{{startDate}} - {{endDate}}{{#if location}} | {{location}}{{/if}}</span>\n          </div>\n          <div class=\"description\">{{description}}</div>\n          <ul class=\"achievements\">\n            {{#each achievements}}\n            <li>{{this}}</li>\n            {{/each}}\n          </ul>\n        </div>\n        {{/each}}\n      </div>\n    </div>\n  </div>\n</body>\n</html>",
  "cssContent": "",
  "sections": [
    "summary",
    "experience",
    "strengths",
    "hardSkills",
    "softSkills",
    "education"
  ],
