{
  "id": "navy-gold",
  "name": "Navy Gold",
  "description": "Executive navy with a gold rule above the name and hairline-ruled section headings",
  "htmlContent": "<!DOCTYPE html><html id=\"el-1\"><head id=\"el-2\"><meta charset=\"UTF-8\" id=\"el-3\"><title id=\"el-4\">{{name}} - Resume</title><style id=\"el-5\">\n@page { margin: 0.4in 0.45in }\n* { margin: 0; padding: 0; box-sizing: border-box }\nbody {\n  font-family: 'Garamond', Georgia, 'Times New Roman', serif;\n  font-size: 11.5px;\n  line-height: 1.4;\n  color: #1a1a2e;\n  background: #fff;\n}\na { color: #1a1a2e; text-decoration: none; }\n\n/* ── DOCUMENT WRAPPER ── */\n.kv-doc {\n  color: #1a1a2e;\n  background: #fff;\n}\n\n/* ── HEADER ── */\n.kv-doc .header {\n  border-bottom: 3px solid #1a1a2e;\n  padding-bottom: 12px;\n  margin-bottom: 14px;\n  position: relative;\n}\n.kv-doc .header::before {\n  content: '';\n  display: block;\n  width: 48px;\n  height: 3px;\n  background: #b8964e;\n  margin-bottom: 10px;\n}\n.kv-doc .name {\n  font-size: 30px;\n  font-weight: 700;\n  line-height: 1.05;\n  letter-spacing: 0.8px;\n  color: #1a1a2e;\n  text-transform: uppercase;\n}\n.kv-doc .title {\n  margin-top: 4px;\n  font-size: 12.5px;\n  font-weight: 400;\n  font-style: italic;\n  color: #4a5568;\n  letter-spacing: 0.3px;\n}\n.kv-doc .contact {\n  margin-top: 9px;\n  display: flex;\n  flex-wrap: wrap;\n  gap: 3px 20px;\n  font-size: 10.2px;\n  color: #374151;\n}\n.kv-doc .contact-item {\n  display: inline-flex;\n  align-items: center;\n  gap: 5px;\n}\n.icon { width: 9px; height: 9px; color: #b8964e; }\n.kv-doc .section-icon { display: none !important; }\n\n/* ── SECTION ── */\n.kv-doc .section {\n  margin-bottom: 11px;\n}\n.kv-doc .section-title {\n  font-size: 9.5px;\n  text-transform: uppercase;\n  letter-spacing: 2px;\n  font-weight: 700;\n  font-family: Georgia, serif;\n  color: #1a1a2e;\n  border-bottom: none;\n  padding-bottom: 4px;\n  margin-bottom: 6px;\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n.kv-doc .section-title::after {\n  content: '';\n  flex: 1;\n  height: 1px;\n  background: #d1d5db;\n}\n.kv-doc .section-title::before {\n  content: '';\n  display: inline-block;\n  width: 14px;\n  height: 2px;\n  background: #b8964e;\n  flex-shrink: 0;\n}\n.section-title-text { display: inline-block; }\n\n/* ── ALL TEXT COLORS ── */\n.kv-doc .section-content,\n.kv-doc .section-body,\n.kv-doc .job-title,\n.kv-doc .company-line,\n.kv-doc .experience-desc,\n.kv-doc .achievements,\n.kv-doc .skills-list,\n.kv-doc .strength-title,\n.kv-doc .strength-description,\n.kv-doc .degree,\n.kv-doc .institution,\n.kv-doc .edu-date {\n  color: #1a1a2e;\n}\n\n/* ── EXPERIENCE ── */\n.kv-doc .job-title {\n  font-weight: 700;\n  font-size: 12px;\n  color: #1a1a2e;\n}\n.kv-doc .company-line {\n  display: flex;\n  justify-content: space-between;\n  font-size: 10.5px;\n  color: #4a5568;\n  margin-bottom: 3px;\n  font-style: italic;\n}\n.kv-doc .experience-item {\n  margin-bottom: 9px;\n  padding-left: 10px;\n  border-left: 2px solid #e5e7eb;\n}\n.kv-doc .experience-desc {\n  font-size: 10.8px;\n  margin-bottom: 3px;\n  color: #374151;\n}\n.kv-doc .achievements {\n  padding-left: 14px;\n  font-size: 10.8px;\n  color: #374151;\n}\n.kv-doc .achievements li {\n  margin-bottom: 2px;\n}\n\n/* ── SKILLS ── */\n.kv-doc .skills-list {\n  padding-left: 0;\n  margin: 0;\n  font-size: 10.8px;\n  list-style: none;\n  display: flex;\n  flex-wrap: wrap;\n  gap: 4px 0;\n}\n.kv-doc .section-skills .skills-list li,\n.kv-doc .section-soft-skills .skills-list li {\n  break-inside: avoid;\n  padding: 1px 10px 1px 0;\n  color: #1a1a2e;\n}\n.kv-doc .section-skills .skills-list li::before,\n.kv-doc .section-soft-skills .skills-list li::before {\n  content: '▸ ';\n  color: #b8964e;\n  font-size: 9px;\n}\n\n/* skills 4-col */\n.section.section-skills .skills-list { column-count: 4; display: block; }\n.section.section-soft-skills .skills-list { column-count: 4; display: block; }\n\n/* ── STRENGTHS ── */\n.section.section-strengths .strengths-grid { column-count: 2; column-gap: 16px; }\n.section.section-strengths .strength-item { break-inside: avoid; margin-bottom: 5px; }\n.kv-doc .strength-title { font-weight: 700; font-size: 11px; color: #1a1a2e; }\n.kv-doc .strength-description { font-size: 10.5px; color: #4a5568; }\n\n/* ── EDUCATION ── */\n.kv-doc .degree { font-weight: 700; font-size: 11.5px; }\n.kv-doc .institution { font-size: 10.8px; color: #4a5568; font-style: italic; }\n.kv-doc .edu-date { font-size: 10.2px; color: #6b7280; }\n\n/* ── SUMMARY ── */\n.section.section-summary .section-content {\n  font-size: 10.8px;\n  color: #374151;\n  line-height: 1.5;\n}\n\n/* keep backgrounds transparent */\n.header { background: transparent !important; }\n.section-title { background: transparent !important; }\n</style></head><body id=\"el-6\"><div class=\"kv-doc\" id=\"el-7\">\n\n<div class=\"header\" id=\"el-8\">\n  <div class=\"name\" id=\"el-9\">{{#if name}}{{name}}{{/if}}</div>\n  <div class=\"title\" id=\"el-10\">{{#if title}}{{title}}{{/if}}</div>\n  <div class=\"contact\" id=\"el-11\">\n    <span class=\"contact-item\" id=\"el-12\">\n      <svg class=\"icon\" viewBox=\"0 0 24 24\" id=\"el-13\"><path fill=\"currentColor\" d=\"M6.6 10.8a15.5 15.5 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25c1.1.37 2.3.57 3.6.57a1 1 0 0 1 1 1v3.5a1 1 0 0 1-1 1C10.3 21 3 13.7 3 4.5a1 1 0 0 1 1-1H7.5a1 1 0 0 1 1 1c0 1.2.2 2.5.57 3.6a1 1 0 0 1-.25 1z\"/ id=\"el-14\"></svg>\n      {{#if contact}}{{contact.phone}}{{/if}}\n    </span>\n    <span class=\"contact-item\" id=\"el-15\">\n      <svg class=\"icon\" viewBox=\"0 0 24 24\" id=\"el-16\"><path fill=\"currentColor\" d=\"M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm0 4-8 5-8-5V6l8 5 8-5z\"/ id=\"el-17\"></svg>\n      {{#if contact}}{{contact.email}}{{/if}}\n    </span>\n    <span class=\"contact-item\" id=\"el-18\">\n      <svg class=\"icon\" viewBox=\"0 0 24 24\" id=\"el-19\"><path fill=\"currentColor\" d=\"M12 2a7 7 0 0 1 7 7c0 4.9-5 11.6-7 13.9C10 20.6 5 13.9 5 9a7 7 0 0 1 7-7zm0 9a2 2 0 1 0 0-4 2 2 0 0 0 0 4z\"/ id=\"el-20\"></svg>\n      {{#if contact}}{{contact.location}}{{/if}}\n    </span>\n    <span class=\"contact-item\" id=\"el-21\">\n      <svg class=\"icon\" viewBox=\"0 0 24 24\" id=\"el-22\"><path fill=\"currentColor\" d=\"M4 3h16a1 1 0 0 1 1 1v16a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1zm4.9 15v-7.1H6.5V18h2.4zm-1.2-8.2a1.4 1.4 0 1 0 0-2.8 1.4 1.4 0 0 0 0 2.8zM18 18v-4.7c0-2.5-1.3-3.6-3-3.6-1.4 0-2 .8-2.4 1.4v-1.2h-2.4c.03.8.03 7.9 0 7.9h2.4v-4.2c0-.2 0-.5.1-.7.2-.5.7-1 1.5-1 1 0 1 0 1.5 2v3.9H18z\"/ id=\"el-23\"></svg>\n      <a href=\"{{#if contact}}{{contact.linkedin}}{{/if}}\" id=\"el-24\">{{#if contact}}{{contact.linkedin}}{{/if}}</a>\n    </span>\n  </div>\n</div>\n\n<div class=\"section section-summary\" id=\"el-25\">\n  <div class=\"section-title\" id=\"el-26\">\n    <span class=\"section-icon\" aria-hidden=\"true\" id=\"el-27\"><svg viewBox=\"0 0 24 24\" id=\"el-28\"><path fill=\"currentColor\" d=\"M12 12a4 4 0 1 0-4-4a4 4 0 0 0 4 4zm0 2c-4 0-7 2-7 4.5a1.5 1.5 0 0 0 3 0c0-1.4 2-2.5 4-2.5s4 1.1 4 2.5a1.5 1.5 0 0 0 3 0C19 16 16 14 12 14z\"/ id=\"el-29\"></svg></span>\n    <span class=\"section-title-text\" id=\"el-30\">Summary</span>\n  </div>\n  <div class=\"section-content\" id=\"el-31\">{{#if summary}}{{summary}}{{/if}}</div>\n</div>\n\n<div class=\"section section-skills\" id=\"el-32\">\n  <div class=\"section-title\" id=\"el-33\">\n    <span class=\"section-icon\" aria-hidden=\"true\" id=\"el-34\"><svg viewBox=\"0 0 24 24\" id=\"el-35\"><path fill=\"currentColor\" d=\"M22 7a6 6 0 0 1-7.7 5.7l-6 6a2 2 0 0 1-2.8 0l-.8-.8a2 2 0 0 1 0-2.8l6-6A6 6 0 1 1 22 7z\"/ id=\"el-36\"></svg></span>\n    <span class=\"section-title-text\" id=\"el-37\">Skills</span>\n  </div>\n  <div class=\"section-content\" id=\"el-38\">\n    <ul class=\"skills-list\" id=\"el-39\">{{#each hardSkills}}<li id=\"el-40\">{{this}}</li>{{/each}}</ul>\n  </div>\n</div>\n\n<div class=\"section section-experience\" id=\"el-41\">\n  <div class=\"section-title\" id=\"el-42\">\n    <span class=\"section-icon\" aria-hidden=\"true\" id=\"el-43\"><svg viewBox=\"0 0 24 24\" id=\"el-44\"><path fill=\"currentColor\" d=\"M13 2L3 14h7l-1 8 10-12h-7l1-8z\"/ id=\"el-45\"></svg></span>\n    <span class=\"section-title-text\" id=\"el-46\">Experience</span>\n  </div>\n  <div class=\"section-content\" id=\"el-47\">\n    {{#each experience}}<div class=\"experience-item\" id=\"el-48\">\n      <div class=\"job-title\" id=\"el-49\">{{#if title}}{{title}}{{/if}}</div>\n      <div class=\"company-line\" id=\"el-50\">\n        <span id=\"el-51\">{{#if company}}{{company}}{{/if}}</span>\n        <span id=\"el-52\">{{#if startDate}}{{startDate}}{{/if}} - {{#if endDate}}{{endDate}}{{/if}}{{#if location}} | {{location}}{{/if}}</span>\n      </div>\n      <div class=\"experience-desc\" id=\"el-53\">{{#if description}}{{description}}{{/if}}</div>\n      <ul class=\"achievements\" id=\"el-54\">{{#if achievements}}{{#each achievements}}<li id=\"el-55\">{{this}}</li>{{/each}}{{/if}}</ul>\n    </div>{{/each}}\n  </div>\n</div>\n\n<div class=\"section section-soft-skills\" id=\"el-56\">\n  <div class=\"section-title\" id=\"el-57\">\n    <span class=\"section-icon\" aria-hidden=\"true\" id=\"el-58\"><svg viewBox=\"0 0 24 24\" id=\"el-59\"><path fill=\"currentColor\" d=\"M12 3l1.2 3.6L17 7.8l-3.2 1.2L12 13l-1.2-4L7 7.8l3.8-1.2L12 3zm7 7l.7 2.1L22 13l-2.3.9L19 16l-.7-2.1L16 13l2.3-.9L19 10zm-14 2l.6 1.8L7 14l-1.4.5L5 16l-.6-1.8L3 14l1.4-.5L5 12z\"/ id=\"el-60\"></svg></span>\n    <span class=\"section-title-text\" id=\"el-61\">Soft Skills</span>\n  </div>\n  <div class=\"section-content\" id=\"el-62\">\n    <ul class=\"skills-list\" id=\"el-63\">{{#each softSkills}}<li id=\"el-64\">{{this}}</li>{{/each}}</ul>\n  </div>\n</div>\n\n<div class=\"section section-strengths\" id=\"el-65\">\n  <div class=\"section-title\" id=\"el-66\">\n    <span class=\"section-icon\" aria-hidden=\"true\" id=\"el-67\"><svg viewBox=\"0 0 24 24\" id=\"el-68\"><path fill=\"currentColor\" d=\"M10 4h4a2 2 0 0 1 2 2v1h4a2 2 0 0 1 2 2v3H2V9a2 2 0 0 1 2-2h4V6a2 2 0 0 1 2-2zm0 3h4V6h-4zm12 7v5a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-5h7v2h6v-2z\"/ id=\"el-69\"></svg></span>\n    <span class=\"section-title-text\" id=\"el-70\">Strengths</span>\n  </div>\n  <div class=\"section-content strengths-grid\" id=\"el-71\">\n    {{#each strengths}}<div class=\"strength-item\" style=\"margin-bottom:5px\" id=\"el-72\">\n      <div class=\"strength-title\" id=\"el-73\">{{#if title}}{{title}}{{/if}}</div>\n      <div class=\"strength-description\" id=\"el-74\">{{#if description}}{{description}}{{/if}}</div>\n    </div>{{/each}}\n  </div>\n</div>\n\n<div class=\"section section-education\" id=\"el-75\">\n  <div class=\"section-title\" id=\"el-76\">\n    <span class=\"section-icon\" aria-hidden=\"true\" id=\"el-77\"><svg viewBox=\"0 0 24 24\" id=\"el-78\"><path fill=\"currentColor\" d=\"M12 3L1 9l11 6 9-4.9V17h2V9L12 3zm-6 9.7V16c0 2.2 2.7 4 6 4s6-1.8 6-4v-3.3l-6 3.3-6-3.3z\"/ id=\"el-79\"></svg></span>\n    <span class=\"section-title-text\" id=\"el-80\">Education</span>\n  </div>\n  <div class=\"section-content\" id=\"el-81\">\n    {{#each education}}<div style=\"margin-bottom:6px\" id=\"el-82\">\n      <div class=\"degree\" id=\"el-83\">{{#if degree}}{{degree}}{{/if}}</div>\n      <div class=\"institution\" id=\"el-84\">{{#if institution}}{{institution}}{{/if}}</div>\n      <div class=\"edu-date\" id=\"el-85\">{{#if startDate}}{{startDate}}{{/if}} - {{#if endDate}}{{endDate}}{{/if}}{{#if location}} | {{location}}{{/if}}</div>\n    </div>{{/each}}\n  </div>\n</div>\n\n</div></body></html>",
