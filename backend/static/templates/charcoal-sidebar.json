{
  "id": "charcoal-sidebar",
  "name": "Charcoal Sidebar",
  "description": "Two-column layout with a charcoal sidebar for contact and skills, a cream main column and a gold accent strip",
  "htmlContent": "<!DOCTYPE html><html id=\"el-1\"><head id=\"el-2\"><meta charset=\"UTF-8\" id=\"el-3\"><title id=\"el-4\">{{name}} - Resume</title><style id=\"el-5\">\n@page { margin: 0; size: letter; }\n* { margin: 0; padding: 0; box-sizing: border-box; }\n\nbody {\n  font-family: 'Georgia', 'Times New Roman', serif;\n  font-size: 11px;\n  line-height: 1.5;\n  color: #1a1a1a;\n  background: #fff;\n  -webkit-print-color-adjust: exact;\n  print-color-adjust: exact;\n}\n\n.vantage-doc {\n  display: flex;\n  min-height: 100vh;\n  width: 100%;\n}\n\n/* ── SIDEBAR ── */\n.vantage-sidebar {\n  width: 220px;\n  min-width: 220px;\n  background: #1c2b39;\n  color: #e8e2d9;\n  padding: 36px 20px 36px 24px;\n  display: flex;\n  flex-direction: column;\n  gap: 0;\n  position: relative;\n}\n\n.vantage-sidebar::before {\n  content: '';\n  position: absolute;\n  top: 0;\n  left: 0;\n  width: 6px;\n  height: 100%;\n  background: #c8a96e;\n}\n\n.sb-name {\n  font-family: 'Helvetica Neue', Arial, sans-serif;\n  font-size: 22px;\n  font-weight: 700;\n  line-height: 1.15;\n  color: #fff;\n  letter-spacing: -0.3px;\n  margin-bottom: 4px;\n  word-break: break-word;\n}\n\n.sb-title {\n  font-family: 'Helvetica Neue', Arial, sans-serif;\n  font-size: 9.5px;\n  font-weight: 400;\n  letter-spacing: 2px;\n  text-transform: uppercase;\n  color: #c8a96e;\n  margin-bottom: 24px;\n  line-height: 1.4;\n}\n\n.sb-divider {\n  height: 1px;\n  background: rgba(200,169,110,0.35);\n  margin: 0 0 16px 0;\n}\n\n.sb-section {\n  margin-bottom: 22px;\n}\n\n.sb-section-label {\n  font-family: 'Helvetica Neue', Arial, sans-serif;\n  font-size: 8px;\n  font-weight: 700;\n  letter-spacing: 2.5px;\n  text-transform: uppercase;\n  color: #c8a96e;\n  margin-bottom: 10px;\n}\n\n.sb-contact-item {\n  display: flex;\n  align-items: flex-start;\n  gap: 8px;\n  margin-bottom: 7px;\n  font-family: 'Helvetica Neue', Arial, sans-serif;\n  font-size: 9.5px;\n  line-height: 1.4;\n  color: #c8cdd3;\n  word-break: break-all;\n}\n\n.sb-contact-icon {\n  width: 10px;\n  height: 10px;\n  min-width: 10px;\n  margin-top: 1px;\n  color: #c8a96e;\n}\n\n.sb-contact-item a {\n  color: #c8cdd3;\n  text-decoration: none;\n}\n\n.sb-skill-group {\n  margin-bottom: 11px;\n}\n\n.sb-skill-group-name {\n  font-family: 'Helvetica Neue', Arial, sans-serif;\n  font-size: 9px;\n  font-weight: 700;\n  letter-spacing: 0.5px;\n  color: #e8e2d9;\n  margin-bottom: 3px;\n  text-transform: uppercase;\n}\n\n.sb-skill-list {\n  font-family: 'Helvetica Neue', Arial, sans-serif;\n  font-size: 9.5px;\n  color: #9eaab5;\n  line-height: 1.55;\n}\n\n/* ── MAIN COLUMN ── */\n.vantage-main {\n  flex: 1;\n  background: #faf9f7;\n  padding: 36px 36px 36px 32px;\n  display: flex;\n  flex-direction: column;\n  gap: 0;\n}\n\n.main-section {\n  margin-bottom: 20px;\n}\n\n.main-section:last-child {\n  margin-bottom: 0;\n}\n\n.main-section-title {\n  font-family: 'Helvetica Neue', Arial, sans-serif;\n  font-size: 8.5px;\n  font-weight: 700;\n  letter-spacing: 3px;\n  text-transform: uppercase;\n  color: #1c2b39;\n  margin-bottom: 12px;\n  display: flex;\n  align-items: center;\n  gap: 10px;\n}\n\n.main-section-title::after {\n  content: '';\n  flex: 1;\n  height: 1px;\n  background: #d6d0c8;\n}\n\n/* Summary */\n.summary-text {\n  font-family: Georgia, serif;\n  font-size: 11px;\n  line-height: 1.65;\n  color: #3d3d3d;\n  font-style: italic;\n  border-left: 3px solid #c8a96e;\n  padding-left: 14px;\n}\n\n/* Experience */\n.exp-item {\n  margin-bottom: 15px;\n  padding-bottom: 14px;\n  border-bottom: 1px solid #e4e0da;\n}\n\n.exp-item:last-child {\n  border-bottom: none;\n  margin-bottom: 0;\n  padding-bottom: 0;\n}\n\n.exp-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: baseline;\n  margin-bottom: 2px;\n  gap: 12px;\n}\n\n.exp-title {\n  font-family: 'Helvetica Neue', Arial, sans-serif;\n  font-size: 12px;\n  font-weight: 700;\n  color: #1c2b39;\n  line-height: 1.3;\n}\n\n.exp-dates {\n  font-family: 'Helvetica Neue', Arial, sans-serif;\n  font-size: 9px;\n  color: #8a8278;\n  white-space: nowrap;\n  flex-shrink: 0;\n  letter-spacing: 0.3px;\n}\n\n.exp-company-line {\n  font-family: 'Helvetica Neue', Arial, sans-serif;\n  font-size: 10px;\n  color: #c8a96e;\n  font-weight: 600;\n  margin-bottom: 6px;\n  letter-spacing: 0.2px;\n}\n\n.exp-company-line .exp-location {\n  font-weight: 400;\n  color: #8a8278;\n  margin-left: 6px;\n}\n\n.exp-desc {\n  font-family: Georgia, serif;\n  font-size: 10.5px;\n  color: #444;\n  line-height: 1.55;\n  margin-bottom: 5px;\n}\n\n.exp-achievements {\n  padding-left: 0;\n  list-style: none;\n  margin-top: 4px;\n}\n\n.exp-achievements li {\n  font-family: 'Helvetica Neue', Arial, sans-serif;\n  font-size: 10px;\n  color: #3d3d3d;\n  line-height: 1.5;\n  margin-bottom: 3px;\n  padding-left: 12px;\n  position: relative;\n}\n\n.exp-achievements li::before {\n  content: '▸';\n  position: absolute;\n  left: 0;\n  color: #c8a96e;\n  font-size: 8px;\n  top: 2px;\n}\n\n/* Education */\n.edu-item {\n  margin-bottom: 10px;\n}\n\n.edu-item:last-child {\n  margin-bottom: 0;\n}\n\n.edu-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: baseline;\n  gap: 12px;\n}\n\n.edu-degree {\n  font-family: 'Helvetica Neue', Arial, sans-serif;\n  font-size: 11.5px;\n  font-weight: 700;\n  color: #1c2b39;\n}\n\n.edu-dates {\n  font-family: 'Helvetica Neue', Arial, sans-serif;\n  font-size: 9px;\n  color: #8a8278;\n  white-space: nowrap;\n  flex-shrink: 0;\n}\n\n.edu-institution {\n  font-family: 'Helvetica Neue', Arial, sans-serif;\n  font-size: 10px;\n  color: #c8a96e;\n  font-weight: 500;\n  margin-top: 1px;\n}\n\n</style></head><body id=\"el-6\">\n<div class=\"vantage-doc\" id=\"el-7\">\n\n  <!-- SIDEBAR -->\n  <div class=\"vantage-sidebar\" id=\"el-8\">\n    <div class=\"sb-name\" id=\"el-9\">{{#if name}}{{name}}{{/if}}</div>\n    <div class=\"sb-title\" id=\"el-10\">{{#if title}}{{title}}{{/if}}</div>\n\n    <div class=\"sb-divider\" id=\"el-11\"></div>\n\n    <div class=\"sb-section\" id=\"el-12\">\n      <div class=\"sb-section-label\" id=\"el-13\">Contact</div>\n      <div class=\"sb-contact-item\" id=\"el-14\">\n        <svg class=\"sb-contact-icon\" viewBox=\"0 0 24 24\" id=\"el-15\"><path fill=\"currentColor\" d=\"M6.6 10.8a15.5 15.5 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25c1.1.37 2.3.57 3.6.57a1 1 0 0 1 1 1v3.5a1 1 0 0 1-1 1C10.3 21 3 13.7 3 4.5a1 1 0 0 1 1-1H7.5a1 1 0 0 1 1 1c0 1.2.2 2.5.57 3.6a1 1 0 0 1-.25 1z\"/></svg>\n        <span>{{#if contact}}{{contact.phone}}{{/if}}</span>\n      </div>\n      <div class=\"sb-contact-item\" id=\"el-16\">\n        <svg class=\"sb-contact-icon\" viewBox=\"0 0 24 24\" id=\"el-17\"><path fill=\"currentColor\" d=\"M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm0 4-8 5-8-5V6l8 5 8-5z\"/></svg>\n        <span>{{#if contact}}{{contact.email}}{{/if}}</span>\n      </div>\n      <div class=\"sb-contact-item\" id=\"el-18\">\n        <svg class=\"sb-contact-icon\" viewBox=\"0 0 24 24\" id=\"el-19\"><path fill=\"currentColor\" d=\"M12 2a7 7 0 0 1 7 7c0 4.9-5 11.6-7 13.9C10 20.6 5 13.9 5 9a7 7 0 0 1 7-7zm0 9a2 2 0 1 0 0-4 2 2 0 0 0 0 4z\"/></svg>\n        <span>{{#if contact}}{{contact.location}}{{/if}}</span>\n      </div>\n      <div class=\"sb-contact-item\" id=\"el-20\">\n        <svg class=\"sb-contact-icon\" viewBox=\"0 0 24 24\" id=\"el-21\"><path fill=\"currentColor\" d=\"M4 3h16a1 1 0 0 1 1 1v16a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1zm4.9 15v-7.1H6.5V18h2.4zm-1.2-8.2a1.4 1.4 0 1 0 0-2.8 1.4 1.4 0 0 0 0 2.8zM18 18v-4.7c0-2.5-1.3-3.6-3-3.6-1.4 0-2 .8-2.4 1.4v-1.2h-2.4c.03.8.03 7.9 0 7.9h2.4v-4.2c0-.2 0-.5.1-.7.2-.5.7-1 1.5-1 1 0 1 0 1.5 2v3.9H18z\"/></svg>\n        <a href=\"{{#if contact}}{{contact.linkedin}}{{/if}}\">{{#if contact}}{{contact.linkedin}}{{/if}}</a>\n      </div>\n    </div>\n\n    <div class=\"sb-section\" id=\"el-22\">\n      <div class=\"sb-section-label\" id=\"el-23\">Skills</div>\n      {{#each skillCategories}}\n      <div class=\"sb-skill-group\" id=\"el-24\">\n        <div class=\"sb-skill-group-name\" id=\"el-25\">{{category}}</div>\n        <div class=\"sb-skill-list\" id=\"el-26\">{{join skills \" · \"}}</div>\n      </div>\n      {{/each}}\n    </div>\n  </div>\n\n  <!-- MAIN -->\n  <div class=\"vantage-main\" id=\"el-30\">\n\n    <div class=\"main-section\" id=\"el-31\">\n      <div class=\"main-section-title\" id=\"el-32\">Profile</div>\n      <div class=\"summary-text\" id=\"el-33\">{{#if summary}}{{summary}}{{/if}}</div>\n    </div>\n\n    <div class=\"main-section\" id=\"el-40\">\n      <div class=\"main-section-title\" id=\"el-41\">Experience</div>\n      {{#each experience}}\n      <div class=\"exp-item\" id=\"el-42\">\n        <div class=\"exp-header\" id=\"el-43\">\n          <div class=\"exp-title\" id=\"el-44\">{{#if title}}{{title}}{{/if}}</div>\n          <div class=\"exp-dates\" id=\"el-45\">{{#if startDate}}{{startDate}}{{/if}}{{#if endDate}} – {{endDate}}{{/if}}</div>\n        </div>\n        <div class=\"exp-company-line\" id=\"el-46\">\n          {{#if company}}{{company}}{{/if}}{{#if location}}<span class=\"exp-location\">{{location}}</span>{{/if}}\n        </div>\n        <div class=\"exp-desc\" id=\"el-47\">{{#if description}}{{description}}{{/if}}</div>\n        <ul class=\"exp-achievements\" id=\"el-48\">\n          {{#if achievements}}{{#each achievements}}<li id=\"el-49\">{{this}}</li>{{/each}}{{/if}}\n        </ul>\n      </div>\n      {{/each}}\n    </div>\n\n    <div class=\"main-section\" id=\"el-60\">\n      <div class=\"main-section-title\" id=\"el-61\">Education</div>\n      {{#each education}}\n      <div class=\"edu-item\" id=\"el-62\">\n        <div class=\"edu-header\" id=\"el-63\">\n          <div class=\"edu-degree\" id=\"el-64\">{{#if degree}}{{degree}}{{/if}}</div>\n          <div class=\"edu-dates\" id=\"el-65\">{{#if startDate}}{{startDate}}{{/if}}{{#if endDate}} – {{endDate}}{{/if}}</div>\n        </div>\n        <div class=\"edu-institution\" id=\"el-66\">{{#if institution}}{{institution}}{{/if}}</div>\n      </div>\n      {{/each}}\n    </div>\n\n  </div>\n</div>\n</body></html>",
