{
  "id": "navy-rule",
  "name": "Navy Rule",
  "description": "Navy rules beside each section heading, with skills grouped into a three-column category grid",
  "htmlContent": "<!DOCTYPE html><html id=\"el-1\"><head id=\"el-2\"><meta charset=\"UTF-8\" id=\"el-3\"><title id=\"el-4\">{{name}} - Resume</title><style id=\"el-5\">\n@page { margin: 0.4in }\n* { margin: 0; padding: 0; box-sizing: border-box }\nbody {\n  font-family: 'Helvetica Neue', Arial, sans-serif;\n  font-size: 12px;\n  line-height: 1.45;\n  color: #1f2933;\n  background: #fff;\n}\na { color: #0f3d63; text-decoration: none; }\n.new1-doc { color: #1f2933; background: #fff; }\n\n.new1-doc .header {\n  display: flex;\n  flex-direction: column;\n  border-bottom: 3px solid #0f3d63;\n  padding-bottom: 12px;\n  margin-bottom: 16px;\n}\n.new1-doc .name {\n  font-size: 30px;\n  font-weight: 700;\n  letter-spacing: 0.6px;\n  text-transform: none;\n  color: #0f3d63;\n}\n.new1-doc .title {\n  margin-top: 3px;\n  font-size: 13.5px;\n  font-weight: 500;\n  letter-spacing: 0.4px;\n  color: #52606d;\n}\n.new1-doc .contact {\n  margin-top: 10px;\n  display: flex;\n  flex-wrap: wrap;\n  gap: 6px 20px;\n  font-size: 10.5px;\n  color: #3e4c59;\n}\n.new1-doc .contact-item { display: inline-flex; align-items: center; gap: 5px; }\n.icon { width: 10px; height: 10px; color: #0f3d63; }\n.new1-doc .section-icon { display: none !important; }\n\n.new1-doc .section { margin-bottom: 12px; }\n.new1-doc .section-title {\n  font-size: 11.5px;\n  text-transform: uppercase;\n  letter-spacing: 1.6px;\n  font-weight: 700;\n  color: #0f3d63 !important;\n  border-left: 4px solid #0f3d63;\n  padding-left: 8px;\n  margin-bottom: 8px;\n}\n.new1-doc .section-content,\n.new1-doc .section-body,\n.new1-doc .section-icon,\n.new1-doc .job-title,\n.new1-doc .company-line,\n.new1-doc .experience-desc,\n.new1-doc .achievements,\n.new1-doc .skill-category-skills,\n.new1-doc .degree,\n.new1-doc .institution,\n.new1-doc .edu-date { color: #1f2933 !important; }\n\n.new1-doc .job-title { font-weight: 700; font-size: 12.6px; color: #0f3d63 !important; }\n.new1-doc .company-line {\n  display: flex;\n  justify-content: space-between;\n  font-size: 10.6px;\n  font-style: italic;\n  color: #52606d;\n  margin-bottom: 3px;\n}\n.new1-doc .experience-item {\n  margin-bottom: 11px;\n  padding-bottom: 8px;\n  border-bottom: 1px solid #e4e7eb;\n}\n.new1-doc .experience-item:last-child { border-bottom: none; }\n.new1-doc .achievements { padding-left: 16px; font-size: 11px; }\n.new1-doc .achievements li { margin-bottom: 2px; }\n.new1-doc .skill-category { break-inside: avoid; margin-bottom: 7px; }\n.new1-doc .skill-category-title { font-weight: 700; color: #0f3d63; margin-bottom: 2px; font-size: 11px; }\n.new1-doc .skill-category-skills { font-size: 11px; line-height: 1.35; }\n.new1-doc .education-item { margin-bottom: 7px; }\n.new1-doc .education-header { display: flex; justify-content: space-between; gap: 14px; align-items: baseline; }\n.new1-doc .education-header .degree { min-width: 0; }\n.new1-doc .edu-date { flex: 0 0 auto; text-align: right; white-space: nowrap; font-size: 10.6px; font-style: italic; color: #52606d !important; }\n\n.section-title-text { display: inline-block; }\n.header { background: transparent !important; }\n.section-title { background: transparent !important; }\n\n.section.section-skills .skill-categories { column-count: 3; column-gap: 16px; }\n\n.section.section-summary { background: transparent; font-size: 11px; margin-bottom: 12px; }\n.section.section-summary .section-content { font-size: 11px; line-height: 1.55; }\n\n.section.section-skills { background: transparent; font-size: 11px; margin-bottom: 12px; }\n.section.section-experience { background: transparent; font-size: 11px; margin-bottom: 12px; }\n.section.section-education { background: transparent; font-size: 11px; margin-bottom: 12px; }\n\n.section .section-icon {\n  width: 1em; height: 1em; display: none;\n}\n</style></head><body id=\"el-6\"><div class=\"new1-doc\" id=\"el-7\">\n\n<div class=\"header\" id=\"el-8\">\n  <div class=\"name\" id=\"el-9\">{{#if name}}{{name}}{{/if}}</div>\n  <div class=\"title\" id=\"el-10\">{{#if title}}{{title}}{{/if}}</div>\n  <div class=\"contact\" id=\"el-11\">\n    <span class=\"contact-item\" id=\"el-12\"><svg class=\"icon\" viewBox=\"0 0 24 24\" id=\"el-13\"><path fill=\"currentColor\" d=\"M6.6 10.8a15.5 15.5 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25c1.1.37 2.3.57 3.6.57a1 1 0 0 1 1 1v3.5a1 1 0 0 1-1 1C10.3 21 3 13.7 3 4.5a1 1 0 0 1 1-1H7.5a1 1 0 0 1 1 1c0 1.2.2 2.5.57 3.6a1 1 0 0 1-.25 1z\"/ id=\"el-14\"></svg>{{#if contact}}{{contact.phone}}{{/if}}</span>\n    <span class=\"contact-item\" id=\"el-15\"><svg class=\"icon\" viewBox=\"0 0 24 24\" id=\"el-16\"><path fill=\"currentColor\" d=\"M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm0 4-8 5-8-5V6l8 5 8-5z\"/ id=\"el-17\"></svg>{{#if contact}}{{contact.email}}{{/if}}</span>\n    <span class=\"contact-item\" id=\"el-18\"><svg class=\"icon\" viewBox=\"0 0 24 24\" id=\"el-19\"><path fill=\"currentColor\" d=\"M12 2a7 7 0 0 1 7 7c0 4.9-5 11.6-7 13.9C10 20.6 5 13.9 5 9a7 7 0 0 1 7-7zm0 9a2 2 0 1 0 0-4 2 2 0 0 0 0 4z\"/ id=\"el-20\"></svg>{{#if contact}}{{contact.location}}{{/if}}</span>\n    <span class=\"contact-item\" id=\"el-21\"><svg class=\"icon\" viewBox=\"0 0 24 24\" id=\"el-22\"><path fill=\"currentColor\" d=\"M4 3h16a1 1 0 0 1 1 1v16a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1zm4.9 15v-7.1H6.5V18h2.4zm-1.2-8.2a1.4 1.4 0 1 0 0-2.8 1.4 1.4 0 0 0 0 2.8zM18 18v-4.7c0-2.5-1.3-3.6-3-3.6-1.4 0-2 .8-2.4 1.4v-1.2h-2.4c.03.8.03 7.9 0 7.9h2.4v-4.2c0-.2 0-.5.1-.7.2-.5.7-1 1.5-1 1 0 1 0 1.5 2v3.9H18z\"/ id=\"el-23\"></svg><a href=\"{{#if contact}}{{contact.linkedin}}{{/if}}\" id=\"el-24\">{{#if contact}}{{contact.linkedin}}{{/if}}</a></span>\n  </div>\n</div>\n\n<div class=\"section section-summary\" id=\"el-25\">\n  <div class=\"section-title\" id=\"el-26\"><span class=\"section-icon\" aria-hidden=\"true\" id=\"el-27\"></span><span class=\"section-title-text\" id=\"el-30\">Professional Summary</span></div>\n  <div class=\"section-content\" id=\"el-31\">{{#if summary}}{{summary}}{{/if}}</div>\n</div>\n\n<div class=\"section section-skills\" id=\"el-32\">\n  <div class=\"section-title\" id=\"el-33\"><span class=\"section-icon\" aria-hidden=\"true\" id=\"el-34\"></span><span class=\"section-title-text\" id=\"el-37\">Technical Skills</span></div>\n  <div class=\"section-content skill-categories\" id=\"el-38\">{{#each skillCategories}}<div class=\"skill-category\" id=\"el-39\"><div class=\"skill-category-title\" id=\"el-40\">{{category}}</div><div class=\"skill-category-skills\" id=\"el-41\">{{join skills \", \"}}</div></div>{{/each}}</div>\n</div>\n\n<div class=\"section section-experience\" id=\"el-41\">\n  <div class=\"section-title\" id=\"el-42\"><span class=\"section-icon\" aria-hidden=\"true\" id=\"el-43\"></span><span class=\"section-title-text\" id=\"el-46\">Professional Experience</span></div>\n  <div class=\"section-content\" id=\"el-47\">{{#each experience}}<div class=\"experience-item\" id=\"el-48\"><div class=\"job-title\" id=\"el-49\">{{#if title}}{{title}}{{/if}}</div><div class=\"company-line\" id=\"el-50\"><span id=\"el-51\">{{#if company}}{{company}}{{/if}}</span><span id=\"el-52\">{{#if startDate}}{{startDate}}{{/if}} - {{#if endDate}}{{endDate}}{{/if}}{{#if location}} | {{location}}{{/if}}</span></div><div class=\"experience-desc\" id=\"el-53\">{{#if description}}{{description}}{{/if}}</div><ul class=\"achievements\" id=\"el-54\">{{#if achievements}}{{#each achievements}}<li id=\"el-55\">{{this}}</li>{{/each}}{{/if}}</ul></div>{{/each}}</div>\n</div>\n\n<div class=\"section section-education\" id=\"el-75\">\n  <div class=\"section-title\" id=\"el-76\"><span class=\"section-icon\" aria-hidden=\"true\" id=\"el-77\"></span><span class=\"section-title-text\" id=\"el-80\">Education</span></div>\n  <div class=\"section-content\" id=\"el-81\">{{#each education}}<div class=\"education-item\" id=\"el-82\"><div class=\"education-header\" id=\"el-83\"><div class=\"degree\" id=\"el-84\">{{#if degree}}{{degree}}{{/if}}</div><div class=\"edu-date\" id=\"el-85\">{{#if startDate}}{{startDate}}{{/if}} - {{#if endDate}}{{endDate}}{{/if}}{{#if location}} | {{location}}{{/if}}</div></div><div class=\"institution\" id=\"el-86\">{{#if institution}}{{institution}}{{/if}}</div></div>{{/each}}</div>\n</div>\n\n</div></body></html>",
  "cssContent": ".new1-doc .section.section-skills .skill-categories { column-count: initial !important; display: grid !important; grid-template-columns: repeat(3, 1fr); gap: 1px 16px; align-items: stretch; }\n.new1-doc .section.section-skills .skill-category { min-height: 54px; margin-bottom: 0 !important; display: flex; flex-direction: column; }\n.new1-doc .section.section-skills .skill-category-skills { flex: 1; }",
  "sections": [
