  "description": "Editorial monochrome dossier with a shaded summary panel and monospaced date columns aligned right of every entry",
  "htmlContent": "<!DOCTYPE html><html><head><meta charset=\"UTF-8\"><title>{{name}} - Resume</title><style>@page { margin: 0.35in }* { margin: 0; padding: 0; box-sizing: border-box }body { font-family: Georgia, 'Times New Roman', serif; font-size: 10px; line-height: 1.35; color: #111; background: #fff; }a { color: #111; text-decoration: none; }.new2-doc { color: #111; background: #fff; }.new2-doc .header { margin-bottom: 18px; }.new2-doc .header-main { border-bottom: 1px solid rgba(17,17,17,0.36); padding-bottom: 12px; }.new2-doc .name { font-size: 23.5px; font-weight: 900; line-height: 0.96; letter-spacing: 0.2px; color: #111; }.new2-doc .title { margin-top: 8px; font-size: 10.2px; font-weight: 600; color: rgba(17,17,17,0.74); max-width: 78%; }.new2-doc .contact { margin-top: 12px; padding-top: 10px; border-top: 1px solid rgba(17,17,17,0.12); display: flex; flex-wrap: wrap; gap: 8px 16px; font-size: 8.8px; color: #111; }.new2-doc .contact-item { display: inline-flex; align-items: center; gap: 6px; }.new2-doc .contact-item,.new2-doc .contact-item a { color: #111; text-decoration: none; }.new2-doc .contact-item .icon { display: block; width: 11px; height: 11px; flex-shrink: 0; color: rgba(17,17,17,0.68); }.new2-doc .icon { display: none; }.new2-doc .contact .icon { display: block; }.new2-doc .section { background: transparent; border: 0; box-shadow: none; padding: 0; margin: 0 0 16px; border-radius: 0; }.new2-doc .section-title { display: block; margin-bottom: 10px; padding: 0 0 8px; border-bottom: 1px solid rgba(17,17,17,0.18); }.new2-doc .section-heading { color: #111; font-size: 9.5px; font-weight: 900; letter-spacing: 1.7px; text-transform: uppercase; }.new2-doc .section-icon { display: none !important; }.new2-doc .summary-panel { background: #f5f5f4; border: 1px solid rgba(17,17,17,0.12); padding: 14px 16px 16px; }.new2-doc .summary-copy { font-size: 9.8px; line-height: 1.45; }.new2-doc .skills-list { padding-left: 16px; margin: 0; font-size: 9.2px; }.new2-doc .skills-list li { margin-bottom: 4px; break-inside: avoid; }.new2-doc .job-title { font-size: 10.8px; font-weight: 800; }.new2-doc .strength-item { margin-bottom: 8px; padding-left: 12px; border-left: 2px solid rgba(17,17,17,0.18); }.new2-doc .strength-title { font-weight: 800; }.new2-doc .strength-description { margin-top: 2px; color: rgba(17,17,17,0.78); }.new2-doc .experience-item, .new2-doc .education-item { border-top: 1px solid rgba(17,17,17,0.12); padding-top: 12px; margin-top: 12px; }.new2-doc .experience-item:first-child, .new2-doc .education-item:first-child { border-top: 0; padding-top: 0; margin-top: 0; }.new2-doc .entry-head, .new2-doc .entry-subline { display: flex; justify-content: space-between; gap: 12px; align-items: baseline; }.new2-doc .entry-subline { margin-top: 2px; }.new2-doc .experience-meta, .new2-doc .entry-location, .new2-doc .edu-date { flex-shrink: 0; text-align: right; font-size: 8.4px; font-weight: 700; color: rgba(17,17,17,0.62); }.new2-doc .experience-meta, .new2-doc .edu-date { font-family: 'Courier New', Courier, monospace; letter-spacing: 0.4px; }.new2-doc .company-line { display: block; font-size: 9.2px; font-weight: 700; letter-spacing: 0.4px; text-transform: uppercase; color: rgba(17,17,17,0.72); }.new2-doc .entry-location { text-transform: uppercase; letter-spacing: 0.4px; }.new2-doc .experience-desc { margin-top: 6px; }.new2-doc .achievements { padding-left: 16px; font-size: 9.2px; }.new2-doc .degree { font-weight: 800; font-size: 10.2px; }.new2-doc .institution { margin-top: 2px; font-size: 9.4px; }.new2-doc .section.section-skills .skills-list { column-count: 3; }.new2-doc .section.section-soft-skills .skills-list { column-count: 2; }.new2-doc .section.section-strengths .strengths-grid { column-count: 2; column-gap: 14px; }.new2-doc .section.section-strengths .strength-item { break-inside: avoid; }</style></head><body><div class=\"new2-doc\"><div class=\"header\"><div class=\"header-main\"><div class=\"name\">{{#if name}}{{name}}{{/if}}</div><div class=\"title\">{{#if title}}{{title}}{{/if}}</div><div class=\"contact\"><span class=\"contact-item\"><svg class=\"icon\" viewBox=\"0 0 24 24\"><path fill=\"currentColor\" d=\"M3 5h18v14H3zm2 2v.2l7 4.9 7-4.9V7l-7 5-7-5zm14 10V9.6l-7 4.8-7-4.8V17z\"/></svg>{{#if contact}}{{contact.email}}{{/if}}</span><span class=\"contact-item\"><svg class=\"icon\" viewBox=\"0 0 24 24\"><path fill=\"currentColor\" d=\"M7 3h4l1 5-2 2c1.3 2.5 3.5 4.7 6 6l2-2 5 1v4c0 1.1-.9 2-2 2C10.4 21 3 13.6 3 5c0-1.1.9-2 2-2z\"/></svg>{{#if contact}}{{contact.phone}}{{/if}}</span><span class=\"contact-item\"><svg class=\"icon\" viewBox=\"0 0 24 24\"><path fill=\"currentColor\" d=\"M4 4h16v16H4zM8 9a1.2 1.2 0 1 0 0-2.4A1.2 1.2 0 0 0 8 9zm1 2H7v7h2zm3 0h-2v7h2v-4c0-1.2.8-1.8 1.6-1.8.9 0 1.4.6 1.4 1.7V18h2v-4.7c0-2.1-1.2-3.3-3-3.3-.9 0-1.5.4-2 1z\"/></svg><a href=\"{{#if contact}}{{contact.linkedin}}{{/if}}\">{{#if contact}}{{contact.linkedin}}{{/if}}</a></span><span class=\"contact-item\"><svg class=\"icon\" viewBox=\"0 0 24 24\"><path fill=\"currentColor\" d=\"M12 2 6 8v4c0 4.1 3 7.8 6 10 3-2.2 6-5.9 6-10V8zm0 6a2 2 0 1 1 0 4 2 2 0 0 1 0-4z\"/></svg>{{#if contact}}{{contact.location}}{{/if}}</span></div></div></div><div class=\"section section-summary summary-panel\"><div class=\"section-title\"><span class=\"section-heading\">Summary</span></div><div class=\"section-content summary-copy\">{{#if summary}}{{summary}}{{/if}}</div></div><div class=\"section section-experience\"><div class=\"section-title\"><span class=\"section-heading\">Experience</span></div><div class=\"section-content\">{{#each experience}}<div class=\"experience-item\"><div class=\"entry-head\"><div class=\"job-title\">{{#if title}}{{title}}{{/if}}</div><div class=\"experience-meta\">{{#if startDate}}{{startDate}}{{/if}} - {{#if endDate}}{{endDate}}{{/if}}</div></div><div class=\"entry-subline\"><div class=\"company-line\">{{#if company}}{{company}}{{/if}}</div><div class=\"entry-location\">{{#if location}}{{location}}{{/if}}</div></div><div class=\"experience-desc\">{{#if description}}{{description}}{{/if}}</div><ul class=\"achievements\">{{#if achievements}}{{#each achievements}}<li>{{this}}</li>{{/each}}{{/if}}</ul></div>{{/each}}</div></div><div class=\"section section-skills\"><div class=\"section-title\"><span class=\"section-heading\">Skills</span></div><div class=\"section-content\"><ul class=\"skills-list\">{{#each hardSkills}}<li>{{this}}</li>{{/each}}</ul></div></div><div class=\"section section-soft-skills\"><div class=\"section-title\"><span class=\"section-heading\">Soft Skills</span></div><div class=\"section-content\"><ul class=\"skills-list\">{{#each softSkills}}<li>{{this}}</li>{{/each}}</ul></div></div><div class=\"section section-strengths\"><div class=\"section-title\"><span class=\"section-heading\">Strengths</span></div><div class=\"section-content strengths-grid\">{{#each strengths}}<div class=\"strength-item\"><div class=\"strength-title\">{{#if title}}{{title}}{{/if}}</div><div class=\"strength-description\">{{#if description}}{{description}}{{/if}}</div></div>{{/each}}</div></div><div class=\"section section-education\"><div class=\"section-title\"><span class=\"section-heading\">Education</span></div><div class=\"section-content\">{{#each education}}<div class=\"education-item\"><div class=\"entry-head\"><div class=\"degree\">{{#if degree}}{{degree}}{{/if}}</div><div class=\"edu-date\">{{#if startDate}}{{startDate}}{{/if}} - {{#if endDate}}{{endDate}}{{/if}}</div></div><div class=\"entry-subline\"><div class=\"institution\">{{#if institution}}{{institution}}{{/if}}</div><div class=\"entry-location\">{{#if location}}{{location}}{{/if}}</div></div></div>{{/each}}</div></div></div></body></html>",
