# Backend bind address and port. 0.0.0.0 listens on every interface so the API
# is reachable through whatever IP or hostname the server has.
HOST=0.0.0.0
PORT=3001

# SQLite database directory (the database file is created inside it).
# Left unset it defaults to /data/db on Linux and macOS, and to
# %LOCALAPPDATA%\free_tailor\db on Windows - both of which the backend prints
# at startup. Set it to override; a relative path is resolved from the
# directory the backend was started in.
#   Linux/macOS:  DB_DIR=/data/db        (needs sudo mkdir -p /data/db first)
#   Windows:      DB_DIR=C:\free_tailor\db
#   Either:       DB_DIR=./data/db
# This file is also the only record of which Google spreadsheet belongs to which
# account, so moving the install means moving it - see "Moving to another
# server" in the README before starting a new host on an empty database.
#DB_DIR=

# Optional extra frontend origins allowed by the backend CORS config.
# Origins on the same host as the API are always allowed, so this is only
# needed when the frontend is served from a different machine.
FRONTEND_URL=

# Frontend bind address and port.
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=3000

# Frontend API base. Leave it unset and it is derived from PORT above, which is
# the only way the two cannot drift apart - set PORT and the frontend follows.
# The hostname is swapped for the one the page was loaded from at runtime, so
# only the port and path matter for a local setup.
#
# Set it ONLY to point the frontend at a different machine. If you do set it to
# this machine on a port other than PORT, every API call fails, and a browser
# cannot tell a wrong port from a stopped server - both are "Failed to fetch".
# The backend and the frontend build both say so on startup if it happens.
#NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_FALLBACK_API_URL=
# Optional extra origins allowed to reach the Next.js dev server (comma separated).
NEXT_PUBLIC_ALLOWED_DEV_ORIGINS=
# Optional default calendar.online share link for the calendar page.
NEXT_PUBLIC_CALENDAR_SHARE_URL=

# ---------------------------------------------------------------------------
# AI providers
# ---------------------------------------------------------------------------
# The default provider is `claude-web`: the app drives claude.ai in a Chrome you
# started and signed in to. Free, no API key, nothing metered. See the browser
# chat section further down for how to start that browser.
#
# `claude-cli` - the Claude Code CLI on a signed-in subscription seat - is
# OFFERED, and needs nothing here. Install it and sign it in on the machine
# running the server and it works; the app checks at startup and says so:
#
#   npm i -g @anthropic-ai/claude-code
#   claude auth login          # authMethod must read "oauth_token"
#   claude auth status         # the app checks this at startup
#
# Comma-separated provider ids to LOCK: hide them behind a padlock with a
# reason, instead of letting somebody pick a provider this machine cannot run.
# Worth setting for `claude-cli` on a box with no seat signed in, or on a shared
# install where the seat should not be spent.
AI_LOCKED_PROVIDERS=

# The mirror, and it wins when a provider is named in both, so it stays an
# escape hatch. There is deliberately no button for either in the admin UI: a
# lock says the machine cannot run that provider, and only whoever set the
# machine up can know that has changed.
AI_UNLOCKED_PROVIDERS=

# --------------------------------------------------------------------------
# Accounts and sign-in
# --------------------------------------------------------------------------
#
# Somebody has to be able to sign in. Set up ONE of the two paths below, or the
# login page will say it has no way to sign anybody in and name what is missing.
#
# WHO ADMINISTERS THIS INSTALLATION. Not whoever signs in first - on a server
# anybody can reach, that handed the keys to the quickest stranger.
#
#   ADMIN_EMAILS   when set, names the administrators outright. Wins over
#                  SMTP_USER, and may list several, comma separated.
#   SMTP_USER      otherwise the administrator is whoever owns the mailbox the
#                  sign-in codes are sent FROM - a credential the operator had
#                  to configure, so it identifies them. Ignored for this purpose
#                  when your provider wants a bare username here instead of an
#                  email address.
#
# With NEITHER set there is no administrator and no way to appoint one from the
# UI: nobody can manage accounts, edit prompts or grant credits. Startup says so.
# An account named by either is promoted as soon as it exists - at boot, or on
# its next sign-in - and nobody is ever demoted, so a typo here cannot lock you
# out of your own installation.
ADMIN_EMAILS=

# Credits given to a brand-new account. Zero unless you change it, which means
# the second person to sign in can preview but not download until an
# administrator grants them some. Set it to give an open installation a
# self-serve trial instead; an administrator can always grant more.
#
# The first account to sign in is an administrator, and administrators are
# exempt from credits entirely, so an install is fully usable on day one with
# nobody holding a single credit.
CREDIT_SIGNUP_GRANT=0

# Google sign-in. Create an OAuth 2.0 Client ID of type "Web application" in a
# Google Cloud project, add the address the app is served from to its
# authorized JavaScript origins, and paste the client id here. It is public by
# design - it appears in the page of every site that uses Google sign-in.
GOOGLE_CLIENT_ID=

# Emailed sign-in codes, over real SMTP. All three are required for this path.
# Port 465 is treated as implicit TLS and everything else as STARTTLS, which is
# the single most common way to misconfigure this; SMTP_SECURE overrides it.
# SMTP_FROM defaults to SMTP_USER, which is what most providers require anyway.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# SMTP_SECURE=true

# Everything below is optional and only needed for the metered providers.

# Path to the claude binary, when it is not on the server's PATH.
AI_CLI_BIN=
# Model alias every call uses unless a prompt or the admin UI names another.
AI_CLI_MODEL=sonnet
# Reasoning effort: low | medium | high | xhigh | max.
AI_CLI_EFFORT=low
# Comma-separated models the CLI falls back to when the first is overloaded.
AI_CLI_FALLBACK_MODELS=haiku
# Simultaneous `claude` processes, process-wide across all requests.
AI_CLI_CONCURRENCY=4
# Longest a request may wait for a free slot before giving up (ms). Long by
# default so the per-call deadline below is what actually bounds the wait.
AI_CLI_QUEUE_WAIT_MS=600000
# How long a call may produce NO output before it is treated as wedged (ms).
# At the seat's usage limit the CLI blocks silently rather than failing.
AI_CLI_FIRST_EVENT_MS=30000
# Per-call wall-clock budgets (ms). Resume tailoring is much longer than the rest.
AI_CLI_TIMEOUT_MS=180000
AI_CLI_TIMEOUT_MS_TAILOR=300000
AI_CLI_TIMEOUT_MS_FILTER=60000
# Fixed, empty working directory for the CLI. Defaults to <DB_DIR>/claude-cli-work.
AI_CLI_WORKDIR=
# Set to 1 to let ANTHROPIC_API_KEY reach the CLI. Off by default: an API key
# outranks the subscription, so this silently moves every call onto metered
# billing - the exact thing the CLI provider exists to avoid.
AI_CLI_ALLOW_API_KEY=0
# Set to 1 to allow calls on the plan's paid extra usage once the subscription
# window is spent. Off by default, for the same reason.
AI_CLI_ALLOW_OVERAGE=0
# Optional hard spend ceiling per call, passed to the CLI. 0 disables it.
AI_CLI_MAX_BUDGET_USD=0
# Items one batch endpoint offers to the provider at once (the provider's own
# limit above still bounds concurrent processes).
AI_BATCH_CONCURRENCY=6

# Metered providers. This is the ONLY place their keys come from - the app
# stores no keys of its own and the admin panel has no field for one.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.1
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# ---------------------------------------------------------------------------
# Browser chat providers (claude-web, chatgpt-web)
# ---------------------------------------------------------------------------
# Drive claude.ai / chatgpt.com in a Chrome YOU started and signed in to. No API
# key and nothing metered - the chat plan you already have is the quota.
#
# Register the ports under Admin -> Settings -> Browser Chat (free), then start
# them yourself:
#
#   npm run browser:debug                                   # every registered browser
#   npm run browser:debug -- --list                         # what is registered, and what is up
#   npm run browser:debug -- --port 9333 --site claude-web  # one, and register it
#   npm run browser:debug -- --port 9333 --site claude-web --no-register
#
# When a turn fails, ask the page what it actually offers rather than guessing
# at the selector overrides below:
#
#   npm run browser:doctor            # which candidate matched, per role
#   npm run browser:doctor -- --send  # and one real round trip, step by step
#
# Either flag shape works (--port 9333 or --port=9333), and a flag the script
# does not recognise is an error rather than a quiet fallback to starting the
# whole list.
#
# THE BACKEND NEVER LAUNCHES ONE. It used to, from a Start button on the
# Settings page; that endpoint is gone, so no HTTP request can start a browser. The server only attaches over the DevTools protocol, and
# never closes a window. Note what this means: the prompt - your resume and the
# job description - is typed into a third-party chat window, and it lands in
# that account's chat history. It is also SLOW and strictly one at a time.
#
# Where the debug browser is listening. Loopback by default; anything that can
# reach this port can drive that browser and every session signed in to it.
# The first DevTools port the free chat providers attach to.
#
# This is only the DEFAULT a fresh install begins with: it seeds one browser for
# claude.ai on this port and one for chatgpt.com on the next. From then on the
# list registered under Admin -> Settings -> Browser Chat is what counts - it is
# what the providers send requests to AND what `npm run browser:debug` starts.
# The launcher falls back to these defaults only when it cannot find the
# settings database at all, and says so when it does.
#
# One browser shows ONE chat tab, on its own port and its own profile. That is
# not a preference: a second tab in the same window is a background tab, and
# Chrome freezes those - a DOM read against a frozen renderer never returns.
# Parallelism comes from more browsers, so two browsers for claude.ai means two
# free Claude requests at once. The queue behind them is unbounded and
# first-come-first-served.
AI_WEB_CDP_PORT=9222

# The browser the Settings page starts for the chat providers.
#
# Deliberately NOT CHROME_PATH: that one names the browser this app renders
# PDFs with, and on many machines it points at puppeteer's Chrome for Testing -
# which is exactly the browser that must not be used here, because sign-in
# flows reject one in automation mode. Leave unset to have an installed Chrome,
# Chromium, Edge or Brave found automatically.
#AI_WEB_BROWSER_PATH=/usr/bin/google-chrome

# Extra flags for that browser, for an install that needs them.
#
# A backend in a container has no display and no sandbox, and Chrome there
# exits at once without these. Note the consequence before using them: a
# headless browser cannot be signed in to by hand, so it only makes sense
# against a profile that is already signed in. `--remote-allow-origins` is
# stripped whatever you set it to - it would let any web page you visit drive
# that browser and read the accounts in it.
#AI_WEB_BROWSER_ARGS=--headless=new --no-sandbox
#AI_WEB_CDP_URL=http://127.0.0.1:9222
#
# Selector overrides, `|` between candidates. Needed only when a site changes
# its markup and the built-in candidates stop matching - the backend says which
# role failed. ASSISTANT is the one that must never match your own message.
#AI_WEB_CLAUDE_COMPOSER=div[contenteditable="true"].ProseMirror
#AI_WEB_CLAUDE_ASSISTANT=div[data-is-streaming]|div.font-claude-message
#AI_WEB_CLAUDE_SEND=button[aria-label="Send message"]
#AI_WEB_CLAUDE_BUSY=button[aria-label="Stop response"]
#AI_WEB_CHATGPT_COMPOSER=#prompt-textarea
#AI_WEB_CHATGPT_ASSISTANT=[data-message-author-role="assistant"]
#AI_WEB_CHATGPT_SEND=[data-testid="chat-input-send"]
#AI_WEB_CHATGPT_BUSY=[data-testid="chat-input-stop"]

# --------------------------------------------------------------------------
# GOOGLE SHEETS
# --------------------------------------------------------------------------
#
# Every account gets its own spreadsheet, with one tab per day. The same
# credentials also serve the job scrapers, the sheet filter, the range import
# and the bid assistant - there is ONE set, not one per feature.
#
# Both the Sheets API AND the Drive API must be enabled for the Cloud project
# the credentials belong to. A spreadsheet is a Drive file, so creating one and
# sharing one are both Drive operations, and a project with only Sheets enabled
# fails with a 403 that blames permissions.
#
# Check the whole chain at any time with:   cd backend && npm run sheets:doctor
#
# WHICH CREDENTIAL. Two shapes work, and the difference matters more than it
# looks:
#
#   Your own Google account  (recommended)
#     cd backend && npm run sheets:login
#   Writes google-oauth-credentials.json. Sheets are created in YOUR Drive,
#   which has room, and you can see them all in drive.google.com. Needs an
#   OAuth client (Desktop app) from the Cloud console; the command says where
#   to click. Publish the OAuth consent screen when you are done testing - in
#   Testing mode Google expires the saved consent after seven days.
#
#   A service account key
#   Only works where something else supplies the storage, which in practice
#   means a Google Workspace domain and a shared drive the service account
#   belongs to. On a consumer project a service account is given a Drive quota
#   of ZERO bytes: it authenticates perfectly and can never own a file, so
#   every allocation fails. Leave this path alone unless you have a shared
#   drive.
#
# Where credentials are looked for, first match wins:
#   1. GOOGLE_CREDENTIALS_PATH below
#   2. google-oauth-credentials.json  in backend/, then the repo root
#   3. service-account-key.json       in backend/, then the repo root
# Startup logs which one it chose, and warns if more than one exists.

# Overrides the search above. Point it at either shape; leave empty to search.
GOOGLE_CREDENTIALS_PATH=

# The older name for exactly the same thing, still honoured so existing
# installs keep working. Prefer GOOGLE_CREDENTIALS_PATH in anything new.
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=

# Which day a sheet tab belongs to, as an IANA zone name (e.g. America/New_York).
# Empty uses the server's own zone, which files an evening's work under the next
# day's tab whenever the server runs in UTC and the users do not.
SHEET_TIMEZONE=

# Set to "off" to skip giving spreadsheets, at startup, to accounts that do not
# have one yet. They are picked up on their next sign-in either way, so this is
# about not opening hundreds of conversations with Drive the moment a large
# installation boots.
SHEET_BACKFILL=

# ---------------------------------------------------------------------------
# PAYMENTS
# ---------------------------------------------------------------------------
# Two ways for people to buy credits. Each method is offered ONLY when both of
# its keys are set: a key without a webhook secret is an install that can take
# money and never hear that it did, which would leave every payment pending
# with the money gone. Leave a pair empty to keep that method switched off.
#
# The price per credit is not here - it is set in the app, under
# Admin -> Payments, so it can be changed without a restart. Each payment
# records the price it was made at, so a change never rewrites a past receipt.
#
# CARD, via Stripe. The payment form is EMBEDDED in the buy page rather than a
# redirect to Stripe - but nothing here ever sees a card number either way: the
# form is an iframe served by Stripe and the details go straight to them.
#
# All THREE are needed or the method is not offered. The publishable key is what
# the form in the browser mounts with; it is safe to expose, and it is served to
# the page by the API so that every Stripe value lives in this one file and
# changing one needs no frontend rebuild. Find the secret and publishable keys
# at https://dashboard.stripe.com/test/apikeys
#
# COPY BOTH IN ONE VISIT, from the same page of the same account. The secret key
# creates the checkout session and the publishable key is what the browser asks
# about it, so a pair from two different accounts - or one test key and one live
# key - makes the form report "No such checkout.session" for a session that
# really does exist. It is the single most common way to get this wrong, and the
# error does not say so. Test keys start sk_test_/pk_test_ and live keys
# sk_live_/pk_live_: the two halves must match on both counts.
#
# The webhook secret is a different thing again, and is NOT on that page. Create
# the endpoint in the Stripe dashboard pointing at
#   https://your-server/api/payments/webhook/stripe
# and subscribe it to checkout.session.completed, .async_payment_succeeded,
# .async_payment_failed and .expired, PLUS payment_intent.succeeded,
# payment_intent.payment_failed and payment_intent.canceled - those last three
# are what a saved card's off-session charge emits, and without them a repeat
# purchase takes the money and never credits it. In development, instead run:
#   stripe listen --forward-to localhost:3001/api/payments/webhook/stripe
# which prints the signing secret to use below, forwards every event, and needs
# no domain or HTTPS.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# CRYPTO: Cryptomus.
#
# A custodial gateway with a hosted invoice page. The buyer leaves this app,
# picks their coin and network on Cryptomus's page at Cryptomus's rates, pays,
# and comes back; Cryptomus posts a signed callback and the credits land. None
# of the hard parts of taking crypto - exchange rates, confirmation depth,
# underpayments, dust - happen on this server.
#
# TWO VALUES, from the same merchant account, and the second does DOUBLE DUTY.
# The merchant id is on the dashboard's main page. The payment API key is under
# the same account's API settings, and it both signs the requests this server
# makes AND is the secret every incoming callback is verified against. There is
# no separate webhook secret to find; if you go looking for one you will not
# find it. Keep it out of the frontend and out of version control - anyone
# holding it can forge a callback saying a payment succeeded.
CRYPTOMUS_MERCHANT_ID=
CRYPTOMUS_PAYMENT_API_KEY=

# Where Cryptomus should post its callbacks. OPTIONAL, and empty is fine: the
# same address can be set once in the Cryptomus dashboard, which is how most
# installations do it. Set it here to send it per invoice instead.
#
# It must be THIS SERVER, reachable from the internet, and it must be the API
# rather than the frontend - everything else in this file points a browser at
# the frontend, which is the mistake to expect here:
#   https://your-server/api/payments/webhook/cryptomus
# Left empty, the field is omitted from the request entirely rather than sent
# blank, because a blank one would override the dashboard with nothing.
CRYPTOMUS_CALLBACK_URL=

# Where a provider sends the browser back to after paying. It must be the
# FRONTEND, not the API, or people land on JSON. Defaults to the first
# FRONTEND_URL, or http://localhost:<FRONTEND_PORT>.
PAYMENTS_RETURN_URL=

# ---------------------------------------------------------------------------
# ORDERS
# ---------------------------------------------------------------------------
# How many days a Google Sheet import's resumes are kept before the server
# deletes them. Every import is placed as an order; its files live under
# <outputBaseDir>/<account>/<date>/<profile>/<company>/ and are swept away once
# this many days have passed. The order itself is kept either way, so the list
# still says what was built and that the files have gone.
#
# The expiry is stamped on each order when it is placed, so changing this
# affects new orders only - it can never reach back and delete files somebody
# was already promised. 0 means "delete on the next sweep", which is the quick
# way to see the whole path work. Left unset it is 5.
ORDER_RETENTION_DAYS=

# Chrome used to print resumes and cover letters. Leave empty to use the copy
# puppeteer downloads at install time, or an installed Chrome/Edge/Chromium/
# Brave when that download never happened. Set it to override both - for
# example when the download is blocked and you want an existing browser:
#   Windows: C:\Program Files\Google\Chrome\Application\chrome.exe
#   Ubuntu:  /usr/bin/google-chrome
CHROME_PATH=
