# Backend bind address and port. 0.0.0.0 listens on every interface so the API
# is reachable through whatever IP or hostname the server has.
HOST=0.0.0.0
PORT=3001

# SQLite database directory (the database file is created inside it).
DB_DIR=/data/db

# Optional extra frontend origins allowed by the backend CORS config.
# Origins on the same host as the API are always allowed, so this is only
# needed when the frontend is served from a different machine.
FRONTEND_URL=

# Frontend bind address and port.
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=3000

# Frontend API base. The hostname is swapped for the one the page was loaded
# from at runtime, so only the port and path matter here.
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_FALLBACK_API_URL=
# Optional extra origins allowed to reach the Next.js dev server (comma separated).
NEXT_PUBLIC_ALLOWED_DEV_ORIGINS=
# Optional default calendar.online share link for the calendar page.
NEXT_PUBLIC_CALENDAR_SHARE_URL=

# Optional admin/token settings.
ADMIN_PASSWORD=change-me
ADMIN_TOKEN_SECRET=change-me

# AI provider keys.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.1
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_HTTP_REFERER=http://localhost:3001
OPENROUTER_APP_NAME=Tailored Resume Builder

# Google Sheets service account JSON path.
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=
